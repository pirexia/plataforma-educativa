# Plantilla de /etc/plataforma/plataforma-worker.env (issue #128, revisión de
# seguridad M-1), consumida SOLO por worker.container. Mismo criterio que
# plataforma-postgres.env.example (issue #36): menos radio de daño para un
# proceso que no necesita ver todo lo que ve la API. Se versiona SIN valores;
# el fichero real vive fuera del repositorio, propiedad de root, permisos 0600.
#
# Respecto a plataforma.env, NO incluye: BACKOFFICE_* y BO_* (el worker no
# sirve HTTP), MINIO_ROOT_* ni ningún secreto de contenedores ajenos.
#
# DESVIACIÓN DECLARADA de M-1: sí incluye DB_OWNER_*. Tres trabajos de la
# cola `auth-maintenance` (PurgeLoginAttempts, PurgeSamlAuthRequests,
# PurgeSamlConsumedAssertions) borran por la conexión `pgsql_owner`
# (tablas append-only, REVOKE DELETE para plataforma_app); sin esas dos
# variables fallarían en cada ejecución. Retirarlas exige antes mover esas
# purgas a otro rol: queda como decisión del usuario.

APP_ENV=production
APP_DEBUG=false
APP_NAME="Plataforma de Gestión Educativa"
APP_URL=
# Misma APP_KEY que la API: los trabajos ShouldBeEncrypted (códigos MFA,
# issue #73) se cifran al encolar y se descifran aquí.
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=plataforma-postgres
DB_PORT=5432
DB_DATABASE=plataforma
DB_USERNAME=plataforma_app
DB_PASSWORD=
DB_OWNER_USERNAME=plataforma_owner
DB_OWNER_PASSWORD=
DB_PLATFORM_USERNAME=plataforma_platform
DB_PLATFORM_PASSWORD=
REDIS_HOST=plataforma-redis
CACHE_STORE=redis
LOG_CHANNEL=stderr
TENANCY_BASE_DOMAIN=
QUEUE_CONNECTION=database
# DB_QUEUE_RETRY_AFTER lo fija la propia unidad (180), mayor que --timeout.

# Correo: mismos valores que plataforma.env (MailEnvironmentGuard).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Plataforma de Gestión Educativa"

# Almacenamiento de exportaciones e importaciones (core-exports/core-imports),
# pendiente de 0.10d: se rellena con el disco S3 real cuando exista.
FILESYSTEM_DISK=s3
AWS_BUCKET=
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_USE_PATH_STYLE_ENDPOINT=true
