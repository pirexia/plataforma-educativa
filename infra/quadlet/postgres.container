# Dato, no aplicación: sin plantilla, una sola instancia siempre.

[Unit]
Description=PostgreSQL — datos de tenant y plataforma
After=plataforma-network.service
Wants=plataforma-network.service

[Container]
Image=docker.io/library/postgres:19
ContainerName=plataforma-postgres
Network=plataforma.network
Volume=postgres-cluster.volume:/var/lib/postgresql:Z
# Scripts de aprovisionamiento de tenancy (roles, RLS) — install.sh los
# copia desde infra/containers/postgres/init/ del repositorio al directorio
# de init del host (ruta por modo: ver RUNBOOK.md §3b). No contienen secretos: las
# contraseñas llegan por las variables TENANCY_*_PASSWORD del EnvironmentFile.
Volume=__POSTGRES_INIT_DIR__:/docker-entrypoint-initdb.d:Z,ro
# Fichero propio, no el de la API (issue #36, hallazgo de
# security-reviewer sobre 0.9b): este proceso solo necesita sus propias
# credenciales de arranque, no APP_KEY ni las contraseñas de conexión de
# Laravel.
EnvironmentFile=__ENV_DIR__/plataforma-postgres.env
HealthCmd=pg_isready -U plataforma
HealthInterval=5s
HealthTimeout=3s
HealthRetries=10
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
