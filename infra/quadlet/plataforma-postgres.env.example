# Plantilla de /etc/plataforma/plataforma-postgres.env (ADR-037 §7.2).
#
# Separado de plataforma.env (hallazgo Media de la revisión independiente
# de security-reviewer sobre 0.9b, issue #36): postgres.container solo
# necesita esto, no APP_KEY/DB_*_PASSWORD/MINIO_* — darle el fichero
# completo ampliaba el radio de daño de ese proceso sin necesidad.
#
# Se versiona SIN valores. El fichero real vive fuera del repositorio, en
# /etc/plataforma/<entorno>-postgres.env, propiedad de root, permisos 0600.
# Las contraseñas se GENERAN, no se escriben a mano (RUNBOOK.md).

# Consumidas por el script de aprovisionamiento (infra/containers/postgres/
# init/01-tenancy.sql.tpl) para CREAR los tres roles de ADR-033.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Cada TENANCY_*_PASSWORD debe ser EXACTAMENTE la misma contraseña que su
# DB_*_PASSWORD correspondiente en plataforma.env.example (mismo secreto,
# dos consumidores: este script lo usa para CREAR el rol, Laravel lo usa
# para CONECTAR con él) — no son dos secretos independientes.
TENANCY_OWNER_PASSWORD=
TENANCY_APP_PASSWORD=
TENANCY_PLATFORM_PASSWORD=
