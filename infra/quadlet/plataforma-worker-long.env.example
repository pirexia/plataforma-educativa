# Plantilla de /etc/plataforma/plataforma-worker-long.env (REQ-CURSO 1.12b, revisión de seguridad M2),
# consumida SOLO por worker-long.container. Se versiona SIN valores; el fichero real vive fuera del
# repositorio, propiedad de root, permisos 0600.
#
# Es el entorno mínimo del worker de la cola `long` (copia y reversión del rollover del curso). Respecto
# a plataforma-worker.env, NO incluye:
#   - DB_OWNER_*: ningún trabajo de la cola `long` usa `pgsql_owner` (la copia y la reversión escriben con
#     `plataforma_app` bajo RLS, dentro de TenantContext::runFor). Las purgas append-only que sí la
#     necesitan viven en `auth-maintenance`, que consume worker.container.
#   - DB_PLATFORM_*: ningún trabajo de la cola `long` abre acceso de plataforma (runAsPlatform).
#   - Correo (credenciales), almacenamiento S3/AWS_*: la copia no envía correo ni toca ficheros.
# Un trabajo de esta cola que algún día los necesite exige añadirlos aquí y justificarlo; una consulta
# por `pgsql_owner` o `pgsql_platform` fallaría de forma visible, no silenciosa.

APP_ENV=production
APP_DEBUG=false
APP_NAME="Plataforma de Gestión Educativa"
APP_URL=
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=plataforma-postgres
DB_PORT=5432
DB_DATABASE=plataforma
DB_USERNAME=plataforma_app
DB_PASSWORD=
REDIS_HOST=plataforma-redis
CACHE_STORE=redis
LOG_CHANNEL=stderr
TENANCY_BASE_DOMAIN=
QUEUE_CONNECTION=database

# MailEnvironmentGuard aborta el arranque de cualquier comando con `log`/`array` fuera de local/testing,
# aunque este worker no envíe correo: el mismo valor que plataforma-worker.env, sin credenciales.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
