# Worker de colas (issue #128): `queue:work` sobre el driver `database`;
# Horizon no se adopta (OPEN-BO-23, CLAUDE.md §1). Misma imagen que la API
# (plataforma-api:__TAG__), sin puerto ni etiquetas de Traefik: nadie le
# habla, él consulta la tabla `jobs`.
#
# Una sola instancia por ahora; para más, convertir en plantilla worker@.container
# como api@.container (ADR-037 §6.2). Dos procesos no se pisan: el driver
# `database` reserva cada trabajo con `FOR UPDATE SKIP LOCKED`.
#
# Wants=+After= hacia postgres y redis, nunca Requires=/BindsTo= (ADR-028):
# si la base cae un momento, el worker no debe arrastrarse a una parada;
# `queue:work` reintenta solo y `Restart=always` cubre una caída del proceso.
# Se ordena después de plataforma-migrate para arrancar con el esquema ya
# migrado, pero sin exigirla (expand/contract, RARQ-DEP-003: el worker
# procesa trabajos encolados por la versión anterior).
#
# Orden de --queue = prioridad. Toda cola con ->onQueue() en el código
# debe estar aquí (lo comprueba QueueWorkerDeploymentTest).
# --max-time=3600: el proceso termina solo cada hora y Restart=always lo
# relanza con el código vigente. --timeout=120 < DB_QUEUE_RETRY_AFTER=180.
# StopTimeout=130 deja acabar el trabajo en curso al parar (SIGTERM).
#
# Sin Notify=healthy: el worker no tiene puerto que esperar; el HealthCmd
# (core:queue-health) solo informa en `podman ps`/`systemctl status`.

[Unit]
Description=Worker de colas (queue:work)
After=plataforma-network.service postgres.service redis.service plataforma-migrate.service
Wants=plataforma-network.service postgres.service redis.service plataforma-migrate.service

[Container]
Image=ghcr.io/pirexia/plataforma-api:__TAG__
ContainerName=plataforma-worker
Network=plataforma.network
EnvironmentFile=/etc/plataforma/plataforma.env
Environment=DB_QUEUE_RETRY_AFTER=180
Exec=php artisan queue:work database --queue=auth-mail,core-mail,bo-mail,default,auth-maintenance,core-maintenance,backoffice-maintenance,core-exports,core-imports --tries=3 --backoff=30 --timeout=120 --sleep=3 --max-time=3600 --max-jobs=1000
StopTimeout=130
HealthCmd=php artisan core:queue-health
HealthInterval=60s
HealthTimeout=20s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
TimeoutStopSec=140

[Install]
WantedBy=default.target
