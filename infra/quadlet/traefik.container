# Único punto de entrada (ADR-028 §1/§4). Descubre contenedores por el
# socket de Podman en vez de una IP cacheada — así una recreación de api@
# o web no rompe el enrutado.
#
# ADR-037 §6.3: socket montado en solo lectura, Podman rootless, mientras
# no haya datos reales. Antes del primer dato real hace falta un proxy de
# socket que filtre a los métodos de solo lectura (0.10e, no esta unidad).
#
# TLS (ADR-080 §3.5, 0.10e-c): entrypoint websecure en :443, redirección
# permanente 80→443 y certificado comodín (*.dominio base + el propio
# dominio base como SAN) emitido y renovado por Traefik con ACME DNS-01 y
# el proveedor `cloudflare` de Lego. Cloudflare solo como DNS, SIN su
# proxy (si no, la IP que ve Traefik dejaría de ser la del cliente).
#  - Token: EnvironmentFile del host con CF_DNS_API_TOKEN (plantilla
#    plataforma-traefik.env.example). Nunca en Git ni en esta unidad.
#  - Servidor ACME: por defecto el ENTORNO DE PRUEBAS de Let's Encrypt;
#    se pasa al de producción cambiando ACME_CA_SERVER en plataforma.env y
#    reinstalando, sin editar la unidad. Sus certificados de pruebas no
#    son de confianza para el navegador.
#  - acme.json: volumen traefik-acme (`:Z`). Traefik lo rechaza si no es
#    0600, así que ExecStartPre lo crea y fija 0600 de forma explícita.
#    Perderlo solo obliga a reemitir.
# Cabeceras de seguridad (HSTS, etc.): no se añaden aquí; el dominio de
# producción comparte landing, y includeSubDomains/preload es decisión
# aparte.
#
# REQ-BO (1.6), operacion.md §0.3. Hoy Traefik recibe la conexión
# directamente (PublishPort=80:80, sin nada delante) — la IP del cliente
# que ve es la real, y el middleware `ipallowlist` del backoffice
# (api@.container) compara contra ella sin más. Si algún día hay OTRO
# proxy delante de Traefik (balanceador, CDN, WAF), hace falta añadir
# aquí --entrypoints.web.forwardedHeaders.trustedIPs=<CIDR del proxy> —
# sin eso, la lista blanca de IP del backoffice pasaría a comparar
# contra la IP de ese proxy (o del NAT) y dejaría de proteger nada, SIN
# dar ningún síntoma (ni error, ni log raro, ni 403 que investigar).
# Comprobación operativa obligatoria tras cualquier cambio en la cadena
# de proxies: la IP registrada en admin_action_logs para un acceso
# legítimo tiene que ser la del cliente, nunca una dirección interna.

[Unit]
Description=Traefik — proxy inverso, único punto de entrada
After=plataforma-network.service
Wants=plataforma-network.service

[Container]
Image=docker.io/library/traefik:v3.7.19
EnvironmentFile=__TRAEFIK_ENV_FILE__
ContainerName=plataforma-traefik
Network=plataforma.network
PublishPort=80:80
PublishPort=443:443
Volume=traefik-acme.volume:/acme:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro,Z
Exec=--providers.docker=true \
    --providers.docker.endpoint=unix:///var/run/docker.sock \
    --providers.docker.exposedbydefault=false \
    --providers.docker.network=plataforma-net \
    --entrypoints.web.address=:80 \
    --entrypoints.web.http.redirections.entrypoint.to=websecure \
    --entrypoints.web.http.redirections.entrypoint.scheme=https \
    --entrypoints.web.http.redirections.entrypoint.permanent=true \
    --entrypoints.websecure.address=:443 \
    --entrypoints.websecure.http.tls.certresolver=letsencrypt \
    --entrypoints.websecure.http.tls.domains[0].main=__TENANCY_BASE_DOMAIN__ \
    --entrypoints.websecure.http.tls.domains[0].sans=*.__TENANCY_BASE_DOMAIN__ \
    --certificatesresolvers.letsencrypt.acme.email=__ACME_EMAIL__ \
    --certificatesresolvers.letsencrypt.acme.storage=/acme/acme.json \
    --certificatesresolvers.letsencrypt.acme.caserver=__ACME_CA_SERVER__ \
    --certificatesresolvers.letsencrypt.acme.dnschallenge=true \
    --certificatesresolvers.letsencrypt.acme.dnschallenge.provider=cloudflare \
    --ping=true \
    --api.dashboard=false \
    --log.level=INFO
HealthCmd=traefik healthcheck --ping || exit 1
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=5s
Notify=healthy

[Service]
Restart=always
# Garantiza acme.json existente y 0600 antes de arrancar (Traefik se niega
# a usar uno con otros permisos). Misma imagen y mismo volumen que la unidad.
ExecStartPre=/usr/bin/podman run --rm --entrypoint /bin/sh -v traefik-acme:/acme:Z docker.io/library/traefik:v3.7.19 -c 'touch /acme/acme.json && chmod 600 /acme/acme.json && stat -c %%a /acme/acme.json | grep -qx 600'

[Install]
WantedBy=default.target
