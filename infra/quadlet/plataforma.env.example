# Plantilla de /etc/plataforma/plataforma.env (ADR-037 §7.2).
#
# Consumida por api@.container y plataforma-migrate.container — NO por
# postgres.container, que tiene su propio fichero más pequeño desde el
# hallazgo Media de security-reviewer sobre 0.9b (issue #36):
# plataforma-postgres.env.example. Menos radio de daño para un proceso
# que no necesita ver APP_KEY ni las contraseñas de conexión de Laravel.
#
# Se versiona SIN valores — es la referencia de qué hay que rellenar, nunca
# contiene un valor real. El fichero real vive fuera del repositorio, en
# /etc/plataforma/<entorno>.env, propiedad de root, permisos 0600.
#
# Las contraseñas se GENERAN, no se escriben a mano (RUNBOOK.md tiene el
# comando exacto). Elegidas por una persona es la causa raíz de la mitad
# de los incidentes de este tipo.

# --- Laravel ---
APP_ENV=production
APP_DEBUG=false
# APP_NAME: sin ella, config/app.php cae a "Laravel" (correos, páginas de
# error). Hallazgo de la revisión independiente de doc-reviewer sobre
# 0.9b: la plantilla se anunciaba como completa y no lo era.
APP_NAME="Plataforma de Gestión Educativa"
# APP_URL: multi-tenant por subdominio (ADR-014) — cada tenant genera sus
# URLs con su propio host de petición, esto NO es lo que resuelve esa
# parte. Es el valor de respaldo que usan config/filesystems.php (URL del
# disco público) y config/mail.php (dominio EHLO) cuando no hay petición
# HTTP de por medio (comandos de consola, colas). Sin ella caen en
# silencio a "http://localhost". Usa el dominio base, sin subdominio.
APP_URL=
# APP_KEY: tratamiento aparte (ADR-037 §7.2 punto 4). Custodiada por
# separado de la copia de la base de datos — sin ella, los datos de
# categoría especial cifrados (CLAUDE.md §8) son irrecuperables.
APP_KEY=
# DB_CONNECTION es obligatoria: config/database.php cae a sqlite por
# defecto si falta (bug propio encontrado probando compose.prodlike.yaml,
# 0.9b.5) — la imagen prod no lleva database.sqlite ni .env, así que un
# despliegue sin esta variable fallaría al arrancar en vez de degradarse
# en silencio, pero sigue siendo obligatoria.
DB_CONNECTION=pgsql
DB_HOST=plataforma-postgres
DB_PORT=5432
DB_DATABASE=plataforma
# Los tres roles de ADR-033 (tenant/owner/platform), consumidos por
# Laravel (apps/api/config/database.php, mismos nombres que ci-api.yml)
# para CONECTAR con los roles que crea plataforma-postgres.env.example
# (fichero distinto desde el issue #36). Cada DB_*_PASSWORD debe ser
# EXACTAMENTE la misma contraseña que su TENANCY_*_PASSWORD
# correspondiente en aquel fichero (DB_PASSWORD = TENANCY_APP_PASSWORD,
# DB_OWNER_PASSWORD = TENANCY_OWNER_PASSWORD, DB_PLATFORM_PASSWORD =
# TENANCY_PLATFORM_PASSWORD) — son el mismo secreto visto por dos
# consumidores distintos, no dos secretos independientes.
DB_USERNAME=plataforma_app
DB_PASSWORD=
DB_OWNER_USERNAME=plataforma_owner
DB_OWNER_PASSWORD=
DB_PLATFORM_USERNAME=plataforma_platform
DB_PLATFORM_PASSWORD=
REDIS_HOST=plataforma-redis
# Aplicación stateless (CLAUDE.md §9): logs a stderr, no a
# storage/logs/laravel.log — un contenedor recreado no debe perder sus
# logs ni acumular escritura en una capa de solo lectura.
LOG_CHANNEL=stderr
# ADR-014: dominio real, pendiente de OPEN-08. Sin esto la resolución de
# tenant por subdominio no funciona en staging/producción.
TENANCY_BASE_DOMAIN=

# --- MinIO / almacenamiento (cuando se active, ver 0.10d) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
