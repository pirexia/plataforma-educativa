# Desarrollo: PHP con servidor embebido de Artisan. El código se monta como
# volumen desde apps/api/ (ver compose.yaml); esta imagen solo aporta el
# runtime y las extensiones. La imagen de producción (multi-stage con
# php-fpm y OPcache) se define cuando exista destino de despliegue (0.10).

FROM docker.io/library/php:8.4-cli-bookworm

# Nota: no se purgan las -dev tras compilar. Un intento anterior con
# "apt-get purge --auto-remove" se llevó por delante libpq.so.5 y
# libzip.so.4 (dependencias de las -dev), y pdo_pgsql/zip dejaban de
# cargar en tiempo de ejecución sin que el healthcheck lo detectara
# (no toca la base de datos). Imagen de desarrollo: prima la sencillez
# correcta sobre el tamaño.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev libzip-dev libicu-dev libonig-dev curl \
    && docker-php-ext-install pdo_pgsql pgsql zip intl mbstring \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

EXPOSE 8000

# --no-reload: sin él, ServeCommand filtra las variables de entorno del
# proceso hijo a una lista blanca fija (APP_ENV, PATH, XDEBUG_*...) que NO
# incluye DB_HOST, REDIS_HOST ni ninguna variable propia (TENANCY_*,
# DB_OWNER_*, DB_PLATFORM_*): el hijo cae entonces a leer apps/api/.env tal
# cual, con DB_HOST/REDIS_HOST en 127.0.0.1 (correcto para Artisan desde el
# host, incorrecto dentro del contenedor, donde hay que usar el nombre del
# servicio). Encontrado en el paso 0.7 al fallar /api/health con 500 vacío
# y sin log — el "reload on .env change" de --no-reload es una
# conveniencia de desarrollo en el host, no algo que tenga sentido dentro
# de un contenedor donde el entorno real ya lo fija compose.yaml.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000", "--no-reload"]
