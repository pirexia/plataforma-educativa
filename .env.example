# Copia a .env (gitignored) y sustituye los valores.
# Solo para desarrollo local con datos sintéticos (ADR-030). Nunca credenciales reales.

POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambia-esto-en-local

# Roles de aislamiento multi-tenant (ADR-033), provisionados por
# infra/containers/postgres/init/01-tenancy.sh en el arranque de postgres.
# plataforma_owner ejecuta las migraciones; plataforma_app es el runtime de
# la API y los workers; plataforma_platform es el backoffice (BYPASSRLS).
TENANCY_OWNER_PASSWORD=cambia-esto-en-local
TENANCY_APP_PASSWORD=cambia-esto-en-local
TENANCY_PLATFORM_PASSWORD=cambia-esto-en-local

MINIO_ROOT_USER=plataforma
MINIO_ROOT_PASSWORD=cambia-esto-en-local
